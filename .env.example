# HMAC secret for signing fair-spin proofs (server-only; rotate by changing)
SPIN_SECRET=change-me-to-a-long-random-hex-string

# HTTP port (default 3847)
PORT=3847

# Comma-separated origins, or * for local MVP (lock down on migrate)
CORS_ORIGINS=*

# Shared with GOML Radio (required for admin = all GOML admins)
# Copy from goml-radio scripts/infra/.env — X-Wallet-Token JWTs + X-Admin-Token
SESSION_SECRET=
ADMIN_TOKEN=

# Xaman SignIn for public GOML wallet gate (same keys as GOML)
XAMAN_API_KEY=
XAMAN_API_SECRET=

# Optional: treat this XRPL address as owner when signing in via prize-wheel Xaman
OWNER_WALLET_ADDRESS=

# Optional shop/API tooling password (NOT a GOML admin gate)
# ADMIN_PASSWORD=

# Optional data directory (default ./data)
# DATA_DIR=

# Set COOKIE_SECURE=0 only for plain-http local dev
# COOKIE_SECURE=1

# ===== HOT WALLET CONFIGURATION (GOML SHARED WALLET) =====
# Server-held XRPL wallet for GOML giveaway prizes
# Generate a wallet once and paste the seed here
# SECURITY: This seed is stored ONLY on the server, never exposed to clients
# Example: sEdV19b2X8HgFZSKGE6uqUx9vK3P9AC (testnet seed)
HOT_WALLET_SEED=

# XRPL network: testnet or mainnet (default: testnet)
XRPL_NETWORK=testnet

# ===== STAGING-ONLY TESTNET SENDS (see docs/staging-sends.md) =====
# Master gate: set to true to enable real testnet Payments from staging hot wallet
# STAGING_SENDS_ENABLED=false
# Network gate: must be testnet for sends to work
# XRPL_NETWORK=testnet
# Expected hot wallet address (must match systemd credential seed)
# STAGING_HOT_WALLET_ADDRESS=
# XRP amount per prize (positive number, hard-capped at 25 in code)
# STAGING_PAYOUT_XRP=1
